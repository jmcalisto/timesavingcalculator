<!DOCTYPE html>
<html>
<head>
<style>
  /* Base Styles */
  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    text-align: center;
    background-color: transparent; 
    padding: 20px;
    margin: 0;
  }

  .container {
    max-width: 600px;
    margin: 0 auto;
    background: #ffffff;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    border-top: 5px solid #003359; /* WSE Blue Accent */
  }

  /* Typography */
  h2 {
    color: #003359; /* WSE Blue */
    margin-top: 0;
    font-size: 28px;
    font-weight: 700;
  }

  p.instruction {
    font-size: 18px;
    color: #4a4a4a;
    line-height: 1.4;
    margin-bottom: 10px;
  }

  p.sub-instruction {
    font-size: 14px;
    color: #888;
    margin-top: 0;
    margin-bottom: 30px;
    font-style: italic;
  }

  /* Slider Styling */
  .slider-container {
    position: relative;
    padding: 10px 0;
  }

  input[type=range] {
    width: 100%;
    margin: 15px 0;
    cursor: pointer;
    accent-color: #003359; /* Slides blue on modern browsers */
    height: 8px;
    background: #e0e0e0;
    border-radius: 5px;
    outline: none;
  }

  /* Make the "Thumb" (Handle) bigger for easier clicking */
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: #003359;
    cursor: pointer;
    box-shadow: 0 0 5px rgba(0,0,0,0.3);
  }

  .slider-value {
    font-weight: bold;
    font-size: 24px;
    color: #003359;
    display: block;
    margin-bottom: 10px;
  }

  /* Results Styling */
  .result-box {
    background-color: #f7f9fc;
    border-radius: 8px;
    padding: 25px;
    margin-top: 25px;
    border: 1px solid #e1e8ed;
    transition: transform 0.2s ease;
  }

  .big-impact {
    font-size: 28px;
    font-weight: 800;
    color: #f12c3e; /* WSE Red */
    display: block;
    margin-bottom: 10px;
  }

  .sub-impact {
    font-size: 18px;
    color: #003359; /* WSE Blue */
    font-weight: 500;
  }

  /* Simple animation class */
  .pulse {
    animation: pulse-animation 0.5s;
  }

  @keyframes pulse-animation {
    0% { transform: scale(1); }
    50% { transform: scale(1.02); }
    100% { transform: scale(1); }
  }

</style>
</head>
<body onload="calculate()"> <div class="container">
  <h2>AI Time-Saving Calculator</h2>
  
  <p class="instruction">
    How many <strong>HOURS A WEEK</strong> do you spend on admin tasks, scheduling, formatting, notetaking?
  </p>
  
  <p class="instruction">
    👇 Use the slider below to estimate your time
  </p>
  
  <div class="slider-container">
    <span class="slider-value"><span id="hoursDisplay">5</span> hours</span>
    <input type="range" id="hoursInput" min="0" max="20" value="5" oninput="calculate()">
  </div>

  <div class="result-box" id="resultBox">
    <span id="annualResult" class="big-impact">AI can save you 240 hours</span>
    <span class="sub-impact">That's <span id="weeksResult">6.0</span> full work weeks per year</span>
  </div>
</div>

<script>
function calculate() {
  // 1. Get the value from the slider
  var weekly = document.getElementById("hoursInput").value;
  
  // 2. The Math (48 working weeks in a year)
  var annual = weekly * 48; 
  
  // 3. The Math (40 hour work week)
  var weeksLost = (annual / 40).toFixed(1); 

  // 4. Update the text on screen
  document.getElementById("hoursDisplay").innerText = weekly;
  document.getElementById("annualResult").innerText = "AI can save you " + annual + " hours";
  document.getElementById("weeksResult").innerText = weeksLost;
  
  // 5. Add a tiny pulse effect to the box when it updates (optional polish)
  var box = document.getElementById("resultBox");
  box.classList.remove("pulse");
  void box.offsetWidth; // trigger reflow
  box.classList.add("pulse");
}
</script>

</body>
</html>
